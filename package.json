{
  "name": "oyo-unlocked",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "A proof-gated real-world business adventure",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-oyo-unlocked \"node --test tests/rules/*.test.mjs\"",
    "emulators": "firebase emulators:start --project demo-oyo-unlocked",
    "test:server": "node --test tests/server/*.test.mjs",
    "preview:included": "node scripts/preview.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@firebase/rules-unit-testing": "^5.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
